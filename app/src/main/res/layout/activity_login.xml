<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Login_sign_up_tool.LoginActivity"
    android:padding ="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="채팅 메신저"
        android:textSize="28sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="130dp"
        android:layout_marginLeft="200dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etLoginID"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint ="아이디 입력"
        android:inputType="textEmailAddress"
        android:layout_below ="@id/tvTitle"
        android:layout_marginBottom="16dp"
        />
    <EditText
        android:id="@+id/etLoginpwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="비밀번호 입력"
        android:inputType="textPassword"
        android:layout_below ="@id/etLoginID"
        android:layout_marginBottom="32dp"/>
    <Button
        android:id="@+id/login_Btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_below ="@id/etLoginpwd"
        android:text="로그인"
        android:textSize="16sp"/>
    <Button
        android:id="@+id/sign_up_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:text="회원가입"
        android:layout_below ="@id/login_Btn"
        android:textSize="16sp"/>
    <TextView
        android:id="@+id/social_login"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below ="@id/sign_up_btn"
        android:text="소셜 로그인"
        android:textSize="15sp"
        android:textStyle="bold"/>
    <com.google.android.gms.common.SignInButton
        android:id="@+id/btnGoogleLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below ="@id/social_login"
        android:layout_marginTop="16dp" />

</RelativeLayout>